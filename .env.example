# Copia este archivo a .env y rellena los valores.
# El .env NO se versiona (está en .gitignore): nunca subas credenciales.

# ── Base de datos (MySQL) ────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME_ORDER=bytemarket_order

# ── Service discovery ────────────────────────────────────
EUREKA_URL=http://localhost:8761/eureka/

# ── JWT ──────────────────────────────────────────────────
# DEBE ser el mismo valor en los cuatro servicios de negocio:
# user-service firma el token y los demás verifican la firma.
JWT_SECRET=
JWT_EXPIRATION=86400000

# ── AWS S3 (imágenes del catálogo) ───────────────────────
S3_REGION=us-east-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ROOT_PREFIX=bytemarket

# ── SMTP (correo) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Contraseña de aplicación de Google, no la del correo.
SMTP_PASSWORD=
